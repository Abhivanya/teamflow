NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/teamflow
REDIS_URL=redis://127.0.0.1:6379
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# Optional. Without these, invitation and reset links are printed in the API log.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=TeamFlow <noreply@example.com>

# Optional absolute path. Defaults to server/uploads.
# UPLOAD_DIR=
